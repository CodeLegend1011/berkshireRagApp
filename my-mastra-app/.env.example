# ==============================
# 🌐 SERVER CONFIGURATION
# ==============================
PORT=8080
MASTRA_ENV=development
MASTRA_LOG_LEVEL=info

# ==============================
# 🧠 AI MODEL CONFIGURATION
# ==============================
# Google Gemini API (Generative + Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional: OpenAI API for fallback or comparison
OPENAI_API_KEY=your_openai_api_key_here

# Default model settings
DEFAULT_GEN_MODEL=gemini-2.0-flash-exp
DEFAULT_EMBED_MODEL=text-embedding-004

# ==============================
# 🗄️ DATABASE CONFIGURATION
# ==============================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/berkshire_rag
PGVECTOR_DIM=768
PG_MAX_CLIENTS=10

# ==============================
# 🧩 APPLICATION SECURITY
# ==============================
JWT_SECRET=your_secure_jwt_secret_here
ADMIN_API_KEY=your_admin_ingestion_key_here

# ==============================
# ⚙️ VECTOR SEARCH & RAG TUNING
# ==============================
VECTOR_SIMILARITY_THRESHOLD=0.75
HYBRID_SQL_LIMIT=50
